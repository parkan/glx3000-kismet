#!/bin/sh
# survey session manager -- start/stop/status a kismet survey session.
# usage: survey start [monitor|scan] | stop | status
#
# monitor (default): passive capture on mon0/mon1 -- RX-only, full frames
#                    (management, probes, clients). the mission default.
# scan:              active iw-scan feeder pushed to kismet's API. transmits
#                    probe requests and needs managed interfaces -- off the
#                    passive path, kept for completeness (enable radios first).
#
# reconciled from the survey-ui branch for the SD/GPS layout: logs to the SD at
# /mnt/kismet (mounted by fstab), uses the gpsd *service* (does not spawn its
# own), and talks to kismet with the fixed survey:survey creds set in
# kismet_site.conf.

SURVEY_DIR="/tmp/survey"
SESSION_FILE="$SURVEY_DIR/session.json"
FEEDER_PID="$SURVEY_DIR/feeder.pid"
KISMET_PID="$SURVEY_DIR/kismet.pid"
SOURCES_CONF="$SURVEY_DIR/sources.conf"
CONFIG="/etc/survey/config.json"
LOG_DIR="/mnt/kismet"
KISMET_AUTH="survey:survey"

scan_interval() { jsonfilter -i "$CONFIG" -e '@.scan_interval' 2>/dev/null || echo 10; }

die() { echo "error: $1" >&2; exit 1; }

is_running() {
	[ -f "$SESSION_FILE" ] && [ -f "$KISMET_PID" ] && kill -0 "$(cat "$KISMET_PID")" 2>/dev/null
}

# stop every kismet and WAIT for it to actually exit. kismet catches SIGTERM and
# flushes its logs (seconds, more with a big kismetdb), so we wait up to 8s then
# SIGKILL stragglers -- otherwise a rapid start/stop leaves instances fighting
# over port 2501.
stop_kismet() {
	pgrep -x kismet >/dev/null 2>&1 || return 0
	killall kismet 2>/dev/null
	local i=0
	while pgrep -x kismet >/dev/null 2>&1 && [ "$i" -lt 8 ]; do sleep 1; i=$((i + 1)); done
	pgrep -x kismet >/dev/null 2>&1 && { killall -9 kismet 2>/dev/null; sleep 1; }
}

setup_storage() {
	mkdir -p "$SURVEY_DIR"
	# the SD auto-mounts at /mnt/kismet via fstab; fall back to RAM if absent.
	# check /proc/mounts directly -- more reliable than mountpoint(1) here.
	if grep -q " $LOG_DIR " /proc/mounts 2>/dev/null; then
		echo "logging to $LOG_DIR (SD)"
	else
		LOG_DIR="$SURVEY_DIR/logs"
		mkdir -p "$LOG_DIR"
		echo "warning: SD not mounted, logging to $LOG_DIR (RAM)" >&2
	fi
}

# ensure passive monitor vifs exist (survey-monitor init usually made them at
# boot) and write a kismet source config pinning each one's channel hop list.
#
# kismet enumerates channels per-DEVICE, but the MT7615 is DBDC -- one device,
# two phys -- so it hands BOTH radios the same 5GHz hop list. The 2.4GHz radio
# then cannot tune anything in its list, every hop silently fails, and it parks
# on ch1 forever: every 2.4GHz network not on ch1 is invisible. So pin each
# source's list to what ITS phy actually reports.
#
# This has to go in a config file consumed via --override: the -c command line
# cannot express it. `-c mon0:channels=1,6,11` is mis-parsed (the comma collides
# with kismet's option separator, so only "1" survives), and quoting it so the
# quotes reach kismet kills the capture helper ("Remote side closed read pipe").
ensure_monitors() {
	local i=0 phy mon chans n=0
	: > "$SOURCES_CONF"
	for phy in /sys/class/ieee80211/*; do
		[ -e "$phy" ] || continue
		phy=$(basename "$phy")
		mon="mon$i"
		[ -e "/sys/class/net/$mon" ] || iw phy "$phy" interface add "$mon" type monitor 2>/dev/null
		ip link set "$mon" up 2>/dev/null
		chans=$(iw phy "$phy" info 2>/dev/null | grep 'MHz \[' | grep -v 'disabled' |
			sed -n 's/.*\[\([0-9]*\)\].*/\1/p' | tr '\n' ',' | sed 's/,$//')
		if [ -n "$chans" ]; then
			echo "source=$mon:channels=\"$chans\"" >> "$SOURCES_CONF"
		else
			echo "source=$mon" >> "$SOURCES_CONF"
		fi
		n=$((n + 1))
		i=$((i + 1))
	done
	[ "$n" -gt 0 ]
}

cmd_start() {
	mode="${1:-monitor}"
	case "$mode" in monitor|scan) ;; *) die "unknown mode: $mode (monitor|scan)" ;; esac

	# clean slate: stop any running kismet + stale state, so a rapid second
	# "start" can't leave two instances fighting over port 2501
	stop_kismet
	rm -f "$SESSION_FILE" "$KISMET_PID" "$FEEDER_PID"

	setup_storage
	timestamp=$(date +%s)
	session_name="survey-$(date +%Y%m%d-%H%M%S)"

	if [ "$mode" = "monitor" ]; then
		ensure_monitors || die "no radios / monitor interfaces available"
		kismet --no-ncurses --daemonize --override "$SOURCES_CONF" \
			-p "$LOG_DIR" -t "$session_name" --log-types kismet 2>/dev/null
		sleep 2
		pgrep -x kismet | head -1 > "$KISMET_PID"
	else
		# active scan: kismet aggregates, feeder pushes iw-scan results.
		# needs managed interfaces -- bring radios up if none are present.
		iw dev 2>/dev/null | grep -q 'type managed' || wifi up 2>/dev/null
		kismet --no-ncurses --daemonize -p "$LOG_DIR" -t "$session_name" \
			--log-types kismet 2>/dev/null
		sleep 2
		pgrep -x kismet | head -1 > "$KISMET_PID"
		SCAN_INTERVAL="$(scan_interval)" /usr/bin/iw-scan-feeder.sh &
		echo "$!" > "$FEEDER_PID"
	fi

	cat > "$SESSION_FILE" <<-EOF
	{"mode":"$mode","started":$timestamp,"name":"$session_name","log_dir":"$LOG_DIR"}
	EOF
	echo "session started: $session_name ($mode)"
}

cmd_stop() {
	is_running || die "no session running"
	name=$(jsonfilter -i "$SESSION_FILE" -e '@.name' 2>/dev/null)
	[ -f "$FEEDER_PID" ] && { kill "$(cat "$FEEDER_PID")" 2>/dev/null; rm -f "$FEEDER_PID"; }
	stop_kismet
	# leave the monitor vifs up -- the box stays passive-ready. deliberately no
	# `wifi up` here (that would beacon as an AP).
	rm -f "$SESSION_FILE" "$KISMET_PID"
	echo "session stopped: $name"
}

cmd_status() {
	if ! is_running; then echo '{"running":false}'; return; fi
	mode=$(jsonfilter -i "$SESSION_FILE" -e '@.mode' 2>/dev/null)
	started=$(jsonfilter -i "$SESSION_FILE" -e '@.started' 2>/dev/null)
	name=$(jsonfilter -i "$SESSION_FILE" -e '@.name' 2>/dev/null)
	log_dir=$(jsonfilter -i "$SESSION_FILE" -e '@.log_dir' 2>/dev/null)
	now=$(date +%s); uptime=$((now - started))
	# kismet's JSON keys are FLAT with literal dots in the name, e.g.
	# {"kismet.common.location.fix": 3}. a dotted jsonfilter path (@.kismet.common...)
	# is parsed as nesting and matches nothing -- must use bracket notation.
	devices=$(curl -s -u "$KISMET_AUTH" "http://127.0.0.1:2501/system/status.json" 2>/dev/null | \
		jsonfilter -e '@["kismet.system.devices.count"]' 2>/dev/null || echo 0)
	gps_fix=$(curl -s -u "$KISMET_AUTH" "http://127.0.0.1:2501/gps/location.json" 2>/dev/null | \
		jsonfilter -e '@["kismet.common.location.fix"]' 2>/dev/null || echo 0)
	[ "$gps_fix" -ge 2 ] 2>/dev/null && gps_fix="true" || gps_fix="false"
	log_size=$(du -sh "$log_dir" 2>/dev/null | awk '{print $1}')
	cat <<-EOF
	{"running":true,"mode":"$mode","name":"$name","uptime":$uptime,"devices":$devices,"gps_fix":$gps_fix,"log_size":"${log_size:-0}"}
	EOF
}

case "${1:-}" in
	start)  cmd_start "$2" ;;
	stop)   cmd_stop ;;
	status) cmd_status ;;
	*)      echo "usage: survey start [monitor|scan] | stop | status" >&2; exit 1 ;;
esac
